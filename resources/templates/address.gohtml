<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{.Title}}</title>
</head>
<body>
    <h1>{{.Name}}</h1>
{{with .Address}}
    <h1>Street :{{.Street}}</h1>
    <h1>City :{{.City}}</h1>
{{else}}
    <h1>No Address</h1>
{{end}}
</body>
</html>